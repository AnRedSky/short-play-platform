# Runtime configuration template.
#
# The application reads, lowest precedence first:
#   1. this file (.env.example)  — built-in defaults for a fresh checkout
#   2. .env                      — your local overrides (git-ignored)
#   3. .env.{APP_ENV}            — environment specific overrides
#   4. real process env vars     — always win
#
# Each file only overrides the keys it defines, so copy this file to .env and
# edit the values you need; leave the rest to inherit from here.

# Application
APP_ENV=development
APP_NAME=short-play-platform
APP_DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-me-for-local-development

# Infrastructure. These match docker/docker-compose.infra.yml defaults; the
# project containers get their own values from docker-compose.yml.
POSTGRES_DB=short_play
POSTGRES_USER=short_play
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://short_play:replace-me@localhost:5432/short_play
REDIS_URL=redis://localhost:6379/0

# Celery: broker and result backend. Default to the shared Redis instance;
# point CELERY_BROKER_URL at amqp://short_play:replace-me@localhost:5672// when
# running the RabbitMQ service from docker/docker-compose.infra.yml.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=UTC
CELERY_TASK_ALWAYS_EAGER=false
RABBITMQ_DEFAULT_USER=short_play
RABBITMQ_DEFAULT_PASS=replace-me

# Storage / media
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE=524288000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Web
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
