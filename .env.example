# Application
APP_ENV=development
APP_NAME=short-play-platform
APP_DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-me-for-local-development
TOKEN_SIGNING_KEY=replace-me-for-local-development
CREDENTIAL_ENCRYPTION_KEY=replace-with-valid-fernet-key

# Infrastructure
POSTGRES_DB=short_play
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:6432/short_play
REDIS_URL=redis://localhost:9770/0

# Celery: broker and result backend. Default to the shared Redis instance;
# point CELERY_BROKER_URL at amqp://... when running the RabbitMQ service
# from docker/docker-compose.infra.yml.
CELERY_BROKER_URL=redis://localhost:9770/0
CELERY_RESULT_BACKEND=redis://localhost:9770/1
CELERY_TIMEZONE=UTC
CELERY_TASK_ALWAYS_EAGER=false
RABBITMQ_DEFAULT_USER=short_play
RABBITMQ_DEFAULT_PASS=replace-me

# Storage / media
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE=524288000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Web
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# AI providers: use mock in development until external credentials are configured
AI_DEFAULT_PROVIDER=mock
