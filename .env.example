# Runtime configuration template — also the lowest-precedence runtime layer.
# Load order: .env.example -> .env -> .env.{APP_ENV} -> process environment.
# Copy to .env and override values as needed. Never commit .env or production secrets.

APP_ENV=development
APP_NAME=short-play-platform
APP_DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-me-for-local-development

# First-run administrator (development only).
# On first API startup with an empty database, this account and its organization
# are created automatically. Subsequent restarts do not reset its password.
# Change this password immediately after the first login.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow-2026!
BOOTSTRAP_ADMIN_FULL_NAME=Platform Administrator
BOOTSTRAP_ORGANIZATION_NAME=Short Play Studio

# Infrastructure (reused shared containers for local development)
POSTGRES_DB=short_play
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:6432/short_play
REDIS_URL=redis://localhost:9770/0

# Celery
CELERY_BROKER_URL=redis://localhost:9770/0
CELERY_RESULT_BACKEND=redis://localhost:9770/1
CELERY_TIMEZONE=UTC
CELERY_TASK_ALWAYS_EAGER=false

# Storage / media
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE=524288000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Web / API observability
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
