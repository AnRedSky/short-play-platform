# Runtime configuration template — also the lowest-precedence runtime layer.
#
# Load order (each layer only overrides the keys it defines):
#   1. .env.example  — these defaults, used by a fresh checkout
#   2. .env          — your local overrides (git-ignored)
#   3. .env.{APP_ENV} — environment specific overrides
#   4. process env vars — always win
#
# Local development reuses the PostgreSQL/Redis containers already running on
# this host (6432 / 9770) instead of starting a second stack. To use the
# dedicated stack from docker/docker-compose.infra.yml instead, point
# DATABASE_URL at postgresql+psycopg://short_play:replace-me@localhost:5432/short_play
# and REDIS_URL / CELERY_* at localhost:6379.
#
# Keep this file and app/config/settings.py in sync: tests/config/test_settings.py
# fails when a scalar default here disagrees with the code default.

# Application
APP_ENV=development
APP_NAME=short-play-platform
APP_DEBUG=false

# API. API_PORT is the single knob for start_api.py, the docker-compose host
# mapping, scripts/e2e_acceptance.py and the Vite dev proxy.
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-me-for-local-development

# Infrastructure (reused shared containers)
POSTGRES_DB=short_play
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:6432/short_play
REDIS_URL=redis://localhost:9770/0

# Celery: broker and result backend on the shared Redis.
CELERY_BROKER_URL=redis://localhost:9770/0
CELERY_RESULT_BACKEND=redis://localhost:9770/1
CELERY_TIMEZONE=UTC
CELERY_TASK_ALWAYS_EAGER=false

# Storage / media
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE=524288000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Web
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
