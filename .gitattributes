# Keep shell scripts, container configs and Python sources LF: they run inside
# Linux containers, where a CRLF shebang or nginx config would break the image.
* text=auto
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
